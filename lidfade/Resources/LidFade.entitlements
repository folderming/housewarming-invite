<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime is required for notarization. No sandbox: the app
	     needs IOKit power management and whole-display capture, neither of
	     which a sandboxed process can reach. This is also why the app cannot
	     ship on the Mac App Store. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<false/>
	<key>com.apple.security.automation.apple-events</key>
	<false/>
</dict>
</plist>
