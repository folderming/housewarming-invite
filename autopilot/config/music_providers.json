{
  "_comment": "음악 생성 API 어댑터 설정. 각 제공자의 엔드포인트/필드명은 변경이 잦으므로 코드가 아니라 여기에 둔다. active를 바꾸면 코드 수정 없이 제공자가 교체된다. 아래 값은 템플릿이며 실제 연동 전에 각 사 최신 문서로 대조할 것.",
  "active": null,
  "providers": {
    "elevenlabs_music": {
      "endpoint": "https://api.elevenlabs.io/v1/music",
      "method": "POST",
      "auth": { "type": "header", "name": "xi-api-key", "env": "ELEVENLABS_API_KEY" },
      "body": { "prompt": "{prompt}", "music_length_ms": "{duration_ms}" },
      "response_audio_path": null,
      "response_is_binary": true,
      "notes": "출력물 상업적 사용 라이선스를 제공하는 편이라 수익화 트랙에 적합. 단일 요청 최대 길이 확인 필요."
    },
    "suno": {
      "endpoint": "https://api.sunoapi.org/api/v1/generate",
      "method": "POST",
      "auth": { "type": "bearer", "env": "SUNO_API_KEY" },
      "body": { "prompt": "{prompt}", "instrumental": true, "model": "V4_5" },
      "response_audio_path": "data.0.audio_url",
      "response_is_binary": false,
      "poll": { "enabled": true, "status_path": "data.0.status", "done_value": "complete" },
      "notes": "공식 API가 아닌 중계 서비스가 다수다. 계정 약관상 상업적 사용 가능 플랜인지 반드시 확인."
    },
    "mureka": {
      "endpoint": "https://api.mureka.ai/v1/song/generate",
      "method": "POST",
      "auth": { "type": "bearer", "env": "MUREKA_API_KEY" },
      "body": { "prompt": "{prompt}", "model": "auto" },
      "response_audio_path": "choices.0.url",
      "response_is_binary": false,
      "notes": "instrumental 지정 방식 확인 필요."
    }
  }
}
